# ==========================================
# AVEN AI — Environment Configuration
# ==========================================

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# Web Search API Key (Optional: DuckDuckGo is used by default if not set)
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=

# Model Overrides & Defaults (Optional)
DEFAULT_MODEL=aven_auto
DEFAULT_TEMPERATURE=0.7
DEFAULT_THEME=aven

# Database Configuration
DATABASE_PATH=data/aven_ai.db

# Bot Security & Performance Limits
RATE_LIMIT_PER_MINUTE=25
MAX_HISTORY_MESSAGES=10
REQUEST_TIMEOUT_SECONDS=60
